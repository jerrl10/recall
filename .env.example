# Path to your Obsidian vault (required)
RECALL_VAULT_PATH=~/Documents/Obsidian/MyVault

# Folder inside the vault that Recall owns (default: Recall)
RECALL_ROOT=Recall

# Subfolder for dated capture logs (default: Daily)
RECALL_DAILY_FOLDER=Daily

# Search tuning
RECALL_MAX_SEARCH_RESULTS=10
RECALL_EXCERPT_CHARS=320

# Hard cap on text returned by note_context (default: 8000)
RECALL_CONTEXT_CHAR_BUDGET=8000

# Subfolder for withdrawn notes (default: Archive)
RECALL_ARCHIVE_FOLDER=Archive

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
RECALL_LOG_LEVEL=INFO

# Search scope: "recall" (only notes Recall wrote) or "vault" (everything)
RECALL_SEARCH_SCOPE=recall

# Folder names never searched, at any depth
RECALL_SEARCH_EXCLUDE=[".obsidian", ".trash", "Templates"]
